from datetime import date
import re

def _parse(text):
    text = text.strip()
    if not re.fullmatch(r"[0-9]{4}([-−])[0-9]{2}\1[0-9]{2}", text):
        raise ValueError("Invalid date syntax")
    return date.fromisoformat(text.replace("−", "-"))

def days_between(a, b):
    return (_parse(b) - _parse(a)).days
