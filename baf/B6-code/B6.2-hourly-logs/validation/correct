from datetime import datetime, timezone
import re

LOG = re.compile(
    r"([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
    r"(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9]))\s+(INFO|WARN|ERROR)\s+([0-9]+)"
)

def aggregate(lines):
    totals = {}
    for line in lines:
        match = LOG.fullmatch(line.strip())
        if not match:
            continue
        try:
            stamp = datetime.fromisoformat(match[1]).astimezone(timezone.utc)
        except (ValueError, OverflowError):
            continue
        hour = stamp.isoformat(timespec="hours").split("+", 1)[0] + ":00Z"
        totals[hour] = totals.get(hour, 0) + int(match[3])
    return totals
