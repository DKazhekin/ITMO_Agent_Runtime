{"operation_id": "38f61940031bea6f9663fb43e596d296-2-0", "tool": "WriteFile", "arguments": {"path": "/work/update_price.py", "content": "import shutil\n\nPATH = '/work/prices.csv'\n\nraw = open(PATH, 'rb').read()\noriginal = raw  # for verification\n\n# Work strictly on bytes so that encoding (cp1251), line endings (CRLF)\n# and every other byte stay untouched.\nassert b'\\r\\n' in raw, 'expected CRLF line endings'\nassert not raw.startswith(b'\\xef\\xbb\\xbf'), 'unexpected BOM'\n\nlines = raw.split(b'\\r\\n')\nheader = lines[0].split(b',')\npid_idx = header.index(b'product_id')\nprice_idx = header.index(b'price')\n\nchanged = 0\nfor i, line in enumerate(lines[1:], start=1):\n    if not line:\n        continue\n    fields = line.split(b',')\n    if fields[pid_idx] == b'X':\n        assert len(fields) == len(header), 'unexpected column count'\n        old = fields[price_idx]\n        fields[price_idx] = b'990'\n        lines[i] = b','.join(fields)\n        changed += 1\n        print('product X: %s -> 990' % old.decode('cp1251'))\n\nassert changed == 1, 'expected exactly one row for product X, found %d' % changed\n\nnew = b'\\r\\n'.join(lines)\nopen(PATH, 'wb').write(new)\n\n# --- verification ---\nafter = open(PATH, 'rb').read()\nprint('decoded cp1251 OK:', after.decode('cp1251').replace('\\r\\n', '|'))\nprint('len before/after:', len(original), len(after))\nprint('CRLF count before/after:', original.count(b'\\r\\n'), after.count(b'\\r\\n'))\nprint('bare LF before/after:', original.count(b'\\n') - original.count(b'\\r\\n'),\n      after.count(b'\\n') - after.count(b'\\r\\n'))\nprint('only expected bytes differ:',\n      original.replace(b',1290\\r\\n', b',990\\r\\n') == after)\n"}, "version": "0", "trace_id": "38f61940031bea6f9663fb43e596d296", "type": "tool_call", "time": 1795176318.613187, "seq": 306}
